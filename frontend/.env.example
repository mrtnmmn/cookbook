# Base URL of the Spring Boot API.
# Local development (default when unset): http://localhost:8085
# Production: set this in the Vercel project settings to the Render URL, e.g.
#   NEXT_PUBLIC_API_BASE_URL=https://cookbook-api.onrender.com
#
# NEXT_PUBLIC_ prefix is required: the value is read in the browser too.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8085

